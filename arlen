const DashboardPage = () => {
    const [financialData, setFinancialData] = useState(initialFinancialData);
    const [analysis, setAnalysis] = useState('');
    const [isAnalyzing, setIsAnalyzing] = useState(false);

    const handleFinancialsChange = (index, field, value) => {
        const newData = [...financialData];
        newData[index][field] = Number(value);
        setFinancialData(newData);
    };

    const generateAnalysis = async () => {
        setIsAnalyzing(true);
        setAnalysis('');
        const apiKey = "";
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-05-20:generateContent?key=${apiKey}`;

        const dataString = financialData.map(d =>
            `- Mês: ${d.month}, Faturamento: R$${d.faturamento}, Custos: R$${d.custos}, Lucro: R$${d.faturamento - d.custos}`
        ).join('\n');

        const systemPrompt = "Você é um analista financeiro sênior para uma empresa de frutas orgânicas chamada GUARUCUM. Sua análise deve ser perspicaz, concisa e fácil de entender para o proprietário da empresa. Forneça insights práticos e acionáveis.";
        const userQuery = `Analise os seguintes dados financeiros mensais da minha empresa e forneça um resumo dos pontos principais, destacando tendências, o melhor e o pior mês, e uma recomendação estratégica. Seja breve e use bullet points (marcadores) para facilitar a leitura.\n\nDados:\n${dataString}`;

        const payload = {
            contents: [{ parts: [{ text: userQuery }] }],
            systemInstruction: {
                parts: [{ text: systemPrompt }]
            },
        };
        
        try {
            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                throw new Error(`API Error: ${response.statusText}`);
            }

            const result = await response.json();
            const candidate = result.candidates?.[0];

            if (candidate && candidate.content?.parts?.[0]?.text) {
                setAnalysis(candidate.content.parts[0].text);
            } else {
                 setAnalysis("Não foi possível gerar a análise. A resposta da API estava em um formato inesperado.");
            }
        } catch (error) {
            console.error("Error generating analysis:", error);
            setAnalysis("Ocorreu um erro ao tentar gerar a análise. Verifique o console para mais detalhes.");
        } finally {
            setIsAnalyzing(false);
        }
    };


    const totals = useMemo(() => {
        return financialData.reduce((acc, item) => {
            const lucro = item.faturamento - item.custos;
            acc.faturamento += item.faturamento;
            acc.custos += item.custos;
            acc.lucro += lucro;
            return acc;
        }, { faturamento: 0, custos: 0, lucro: 0 });
    }, [financialData]);

    const ColumnChart = ({ data }) => {
        const [tooltip, setTooltip] = useState(null); 

        const formatCurrency = (value) => `R$ ${value.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

        const dataWithProfit = data.map(d => ({ ...d, lucro: d.faturamento - d.custos }));
        const maxRaw = Math.max(1, ...dataWithProfit.flatMap(d => [d.faturamento])); 
        const yAxisMax = Math.ceil(maxRaw / 10000) * 10000; 

        const yAxisLabels = [yAxisMax, yAxisMax * 0.75, yAxisMax * 0.5, yAxisMax * 0.25, 0].map(val => ({
            label: `R$ ${(val/1000).toFixed(0)}k`,
            value: val
        }));
        
        const getBarHeight = (value) => {
            const height = Math.max(0, value);
            return `${(height / yAxisMax) * 100}%`;
        };
        
        const handleMouseOver = (e, item, type) => {
            const value = type === 'lucro' ? item.faturamento - item.custos : item[type];
            const content = `<strong>${item.month}</strong><br/>${type.charAt(0).toUpperCase() + type.slice(1)}: ${formatCurrency(value)}`;
            setTooltip({ content, x: e.pageX, y: e.pageY });
        };
        
        const handleMouseMove = (e) => {
            if (tooltip) {
                setTooltip(t => ({ ...t, x: e.pageX, y: e.pageY }));
            }
        };

        const handleMouseOut = () => {
            setTooltip(null);
        };

        return (
            <div className="relative">
                {tooltip && (
                    <div 
                        className="absolute z-10 p-2 text-sm bg-gray-900 text-white rounded-md shadow-lg pointer-events-none transform -translate-x-1/2 -translate-y-full"
                        style={{ left: tooltip.x, top: tooltip.y - 10 }}
                        dangerouslySetInnerHTML={{ __html: tooltip.content }}
                    />
                )}
                <div className="flex gap-2">
                    <div className="flex flex-col justify-between h-80 text-right text-xs text-gray-400 dark:text-gray-500 pr-2 shrink-0">
                        {yAxisLabels.map(label => (
                            <span key={label.value}>{label.label}</span>
                        ))}
                    </div>

                    <div className="w-full h-80 flex items-end justify-around border-b border-l border-gray-300 dark:border-gray-600 relative">
                        {yAxisLabels.slice(0, -1).map(label => (
                             <div key={`line-${label.value}`} className="absolute w-full border-t border-dashed border-gray-200 dark:border-gray-700 left-0" style={{ bottom: `${(label.value / yAxisMax) * 100}%`}}></div>
                        ))}
                        
                        {dataWithProfit.map(item => (
                            <div key={item.month} className="flex-1 h-full flex flex-col items-center justify-end gap-1 px-1 md:px-2 z-0">
                                <div className="flex justify-around items-end w-full h-full">
                                    <div 
                                        onMouseOver={(e) => handleMouseOver(e, item, 'faturamento')} 
                                        onMouseMove={handleMouseMove} 
                                        onMouseOut={handleMouseOut}
                                        className="w-1/3 bg-blue-500 rounded-t-md hover:bg-blue-400 transition-all duration-300 ease-in-out cursor-pointer" 
                                        style={{ height: getBarHeight(item.faturamento) }}>
                                    </div>
                                    <div 
                                        onMouseOver={(e) => handleMouseOver(e, item, 'custos')} 
                                        onMouseMove={handleMouseMove} 
                                        onMouseOut={handleMouseOut}
                                        className="w-1/3 bg-orange-500 rounded-t-md hover:bg-orange-400 transition-all duration-300 ease-in-out cursor-pointer" 
                                        style={{ height: getBarHeight(item.custos) }}>
                                    </div>
                                    <div 
                                        onMouseOver={(e) => handleMouseOver(e, item, 'lucro')} 
                                        onMouseMove={handleMouseMove} 
                                        onMouseOut={handleMouseOut}
                                        className="w-1/3 bg-green-500 rounded-t-md hover:bg-green-400 transition-all duration-300 ease-in-out cursor-pointer" 
                                        style={{ height: getBarHeight(item.lucro) }}>
                                    </div>
                                </div>
                                <span className="text-sm font-medium text-gray-500 dark:text-gray-400 mt-2">{item.month}</span>
                            </div>
                        ))}
                    </div>
                </div>
                 <div className="flex justify-center items-center gap-6 mt-4">
                    <div className="flex items-center gap-2"><div className="w-4 h-4 rounded bg-blue-500"></div><span className="text-sm text-gray-600 dark:text-gray-300">Faturamento</span></div>
                    <div className="flex items-center gap-2"><div className="w-4 h-4 rounded bg-orange-500"></div><span className="text-sm text-gray-600 dark:text-gray-300">Custos</span></div>
                    <div className="flex items-center gap-2"><div className="w-4 h-4 rounded bg-green-500"></div><span className="text-sm text-gray-600 dark:text-gray-300">Lucro</span></div>
                </div>
            </div>
        );
    };

    return (
        <div className="p-4 md:p-8 space-y-8">
            <h1 className="text-3xl font-bold text-gray-800 dark:text-gray-100">Dashboard Financeiro</h1>
            
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div className="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg text-center"><h3 className="text-lg font-semibold text-gray-500 dark:text-gray-400">Faturamento Total</h3><p className="text-4xl font-bold text-blue-600 dark:text-blue-400">R$ {totals.faturamento.toFixed(2)}</p></div>
                <div className="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg text-center"><h3 className="text-lg font-semibold text-gray-500 dark:text-gray-400">Custos Totais</h3><p className="text-4xl font-bold text-orange-600 dark:text-orange-400">R$ {totals.custos.toFixed(2)}</p></div>
                <div className="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg text-center"><h3 className="text-lg font-semibold text-gray-500 dark:text-gray-400">Lucro Total</h3><p className="text-4xl font-bold text-green-600 dark:text-green-400">R$ {totals.lucro.toFixed(2)}</p></div>
                <div className="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg text-center"><h3 className="text-lg font-semibold text-gray-500 dark:text-gray-400">Clientes Ativos</h3><p className="text-4xl font-bold text-purple-600 dark:text-purple-400">2.000</p></div>
            </div>

            {isAnalyzing && (
                 <div className="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg">
                    <div className="flex items-center justify-center gap-3">
                        <SparklesIcon className="text-purple-500 animate-pulse" />
                        <p className="text-lg font-semibold text-gray-700 dark:text-gray-200">Analisando dados financeiros...</p>
                    </div>
                </div>
            )}
             {analysis && (
                 <div className="bg-purple-50 dark:bg-purple-900/20 p-6 rounded-2xl shadow-lg border border-purple-200 dark:border-purple-800">
                    <h2 className="text-xl font-bold text-purple-800 dark:text-purple-300 mb-3 flex items-center gap-2">
                        <SparklesIcon />
                        Análise Financeira com IA
                    </h2>
                    <div className="prose prose-sm dark:prose-invert text-gray-700 dark:text-gray-300 whitespace-pre-wrap">{analysis}</div>
                </div>
            )}

            <div className="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg">
                <div className="flex justify-between items-center mb-4">
                    <h2 className="text-xl font-bold text-gray-700 dark:text-gray-200">Receita Mensal</h2>
                    <button 
                        onClick={generateAnalysis}
                        disabled={isAnalyzing}
                        className="flex items-center gap-2 bg-purple-500 hover:bg-purple-600 text-white font-bold py-2 px-4 rounded-lg transition-colors disabled:bg-purple-300 disabled:cursor-not-allowed">
                        <SparklesIcon />
                        {isAnalyzing ? 'Analisando...' : 'Analisar Dados ✨'}
                    </button>
                </div>
                <ColumnChart data={financialData} />
            </div>

            <div className="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-x-auto">
                <h2 className="text-xl font-bold text-gray-700 dark:text-gray-200 p-6">Dados Editáveis</h2>
                <table className="w-full text-left">
                    <thead className="bg-gray-50 dark:bg-gray-700/50">
                        <tr>
                            {['Mês', 'Faturamento (R$)', 'Custos (R$)', 'Lucro (R$)'].map(h => <th key={h} className="p-4 font-semibold text-gray-600 dark:text-gray-300">{h}</th>)}
                        </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-200 dark:divide-gray-700">
                        {financialData.map((item, index) => (
                            <tr key={item.month} className="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                                <td className="p-4 font-semibold text-gray-800 dark:text-gray-100">{item.month}</td>
                                <td className="p-2"><input type="number" value={item.faturamento} onChange={(e) => handleFinancialsChange(index, 'faturamento', e.target.value)} className="w-full bg-transparent p-2 rounded-lg border-gray-300 dark:border-gray-600 border focus:outline-none focus:ring-2 focus:ring-blue-400" /></td>
                                <td className="p-2"><input type="number" value={item.custos} onChange={(e) => handleFinancialsChange(index, 'custos', e.target.value)} className="w-full bg-transparent p-2 rounded-lg border-gray-300 dark:border-gray-600 border focus:outline-none focus:ring-2 focus:ring-orange-400" /></td>
                                <td className="p-4 font-semibold text-green-600 dark:text-green-400">R$ {(item.faturamento - item.custos).toFixed(2)}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    );
};


// --- COMPONENTE PRINCIPAL ---

export default function App() {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [currentPage, setCurrentPage] = useState('dashboard');
  const [cart, setCart] = useState([]);
  const [darkMode, setDarkMode] = useState(false);

  useEffect(() => {
    if (darkMode) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }, [darkMode]);

  const toggleDarkMode = () => setDarkMode(!darkMode);
  
  const cartItemCount = useMemo(() => {
      return cart.reduce((total, item) => total + item.quantity, 0);
  }, [cart]);

  const handleLogin = useCallback(() => {
    setIsLoggedIn(true);
    setCurrentPage('dashboard');
  }, []);

  if (!isLoggedIn) {
    return <LoginPage onLogin={handleLogin} />;
  }

  const renderPage = () => {
    switch (currentPage) {
      case 'estoque': return <EstoquePage />;
      case 'vendas': return <VendasPage cart={cart} setCart={setCart} />;
      case 'dashboard': return <DashboardPage />;
      default: return <DashboardPage />;
    }
  };

  return (
    <div className="min-h-screen bg-gray-100 dark:bg-gray-900 font-sans transition-colors duration-500">
      <header className="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm shadow-md sticky top-0 z-20">
        <nav className="container mx-auto px-4 sm:px-6 py-3 flex justify-between items-center">
          <div className="flex items-center space-x-3 cursor-pointer" onClick={() => setCurrentPage('dashboard')}>
            <div className="text-green-600 dark:text-green-400"><LeafIcon /></div>
            <h1 className="text-2xl font-bold text-gray-800 dark:text-gray-100">GUARUCUM</h1>
          </div>
          <div className="hidden md:flex items-center space-x-2">
            <NavItem page="dashboard" currentPage={currentPage} setCurrentPage={setCurrentPage}>Dashboard</NavItem>
            <NavItem page="estoque" currentPage={currentPage} setCurrentPage={setCurrentPage}>Estoque</NavItem>
            <NavItem page="vendas" currentPage={currentPage} setCurrentPage={setCurrentPage}>Vendas</NavItem>
          </div>
          <div className="flex items-center space-x-4">
            <button 
              onClick={toggleDarkMode} 
              aria-label={darkMode ? "Ativar modo claro" : "Ativar modo escuro"}
              className="text-gray-600 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                {darkMode ? <SunIcon /> : <MoonIcon />}
            </button>
            <button 
                onClick={() => setCurrentPage('vendas')} 
                aria-label="Ver carrinho de compras"
                className="text-gray-600 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400">
              <ShoppingCartIcon itemCount={cartItemCount} />
            </button>
            <button onClick={() => setIsLoggedIn(false)} className="bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-300 dark:hover:bg-gray-600 font-semibold py-2 px-4 rounded-lg text-sm transition-colors">
              Sair
            </button>
          </div>
        </nav>
        <div className="md:hidden flex justify-around p-2 bg-gray-100 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
            <NavItem page="dashboard" currentPage={currentPage} setCurrentPage={setCurrentPage}>Dashboard</NavItem>
            <NavItem page="estoque" currentPage={currentPage} setCurrentPage={setCurrentPage}>Estoque</NavItem>
            <NavItem page="vendas" currentPage={currentPage} setCurrentPage={setCurrentPage}>Vendas</NavItem>
        </div>
      </header>
      <main className="container mx-auto px-2 sm:px-4 py-8">
        {renderPage()}
      </main>
    </div>
  );
}

const NavItem = React.memo(({ page, currentPage, setCurrentPage, children }) => (
    <button 
        onClick={() => setCurrentPage(page)}
        className={`font-semibold transition-colors duration-200 px-4 py-2 rounded-md ${ 
            currentPage === page 
            ? 'text-green-600 dark:text-green-400 bg-green-100 dark:bg-green-900/30' 
            : 'text-gray-600 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 hover:bg-gray-200 dark:hover:bg-gray-700'
        }`}
    >
        {children}
    </button>
));

