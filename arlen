const EstoquePage = () => {
  const [stock, setStock] = useState(initialStock);
  const handleStockChange = (id, field, value) => setStock(currentStock => currentStock.map(item => item.id === id ? { ...item, [field]: value } : item));
  const getStatusColor = (status) => {
    switch (status) {
      case 'Excelente': return 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 focus:ring-green-400';
      case 'Bom': return 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 focus:ring-blue-400';
      case 'Atenção': return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300 focus:ring-yellow-400';
      default: return 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300 focus:ring-gray-400';
    }
  };
  const totalQuantity = stock.reduce((acc, item) => acc + Number(item.quantity), 0);
  const avgTemp = stock.reduce((acc, item) => acc + Number(item.temperature), 0) / stock.length;

  return (
    <div className="p-4 md:p-8">
      <h1 className="text-3xl font-bold text-gray-800 dark:text-gray-100 mb-6">Painel de Estoque Editável</h1>
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          {[{title: 'Itens em Estoque', value: stock.length, unit:''}, {title:'Quantidade Total', value: totalQuantity.toFixed(0), unit: 'kg'}, {title: 'Temp. Média', value: avgTemp.toFixed(1), unit: '°C'}].map(card => (
            <div key={card.title} className="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg flex flex-col justify-center items-center">
                <h3 className="text-lg font-semibold text-gray-500 dark:text-gray-400 mb-2">{card.title}</h3>
                <p className="text-4xl font-bold text-green-600 dark:text-green-400">{card.value} <span className="text-xl">{card.unit}</span></p>
            </div>
          ))}
      </div>
      <div className="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-x-auto">
        <table className="w-full text-left">
          <thead className="bg-gray-50 dark:bg-gray-700/50">
            <tr>
              {['Fruta', 'Data Entrada', 'Quantidade (kg)', 'Temperatura (°C)', 'Status'].map(h => <th key={h} className="p-4 font-semibold text-gray-600 dark:text-gray-300">{h}</th>)}
            </tr>
          </thead>
          <tbody className="divide-y divide-gray-200 dark:divide-gray-700">
            {stock.map((item) => (
              <tr key={item.id} className="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td className="p-2 font-semibold text-gray-800 dark:text-gray-100">{item.name}</td>
                <td className="p-2"> <input type="date" value={item.entryDate} onChange={(e) => handleStockChange(item.id, 'entryDate', e.target.value)} className="w-full bg-transparent p-2 rounded-lg border-gray-300 dark:border-gray-600 border focus:outline-none focus:ring-2 focus:ring-green-400" /> </td>
                <td className="p-2"> <input type="number" value={item.quantity} onChange={(e) => handleStockChange(item.id, 'quantity', e.target.value)} className="w-24 bg-transparent p-2 rounded-lg border-gray-300 dark:border-gray-600 border focus:outline-none focus:ring-2 focus:ring-green-400" /> </td>
                <td className="p-2"> <input type="number" value={item.temperature} onChange={(e) => handleStockChange(item.id, 'temperature', e.target.value)} className="w-20 bg-transparent p-2 rounded-lg border-gray-300 dark:border-gray-600 border focus:outline-none focus:ring-2 focus:ring-green-400" /> </td>
                <td className="p-2">
                  <select value={item.status} onChange={(e) => handleStockChange(item.id, 'status', e.target.value)} className={`w-full p-2.5 appearance-none rounded-lg border-transparent border focus:outline-none focus:ring-2 font-semibold ${getStatusColor(item.status)}`}>
                    <option className="bg-white dark:bg-gray-800" value="Excelente">Excelente</option> <option className="bg-white dark:bg-gray-800" value="Bom">Bom</option> <option className="bg-white dark:bg-gray-800" value="Atenção">Atenção</option>
                  </select>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
};

const VendasPage = ({ cart, setCart }) => {
    const addToCart = (product) => setCart(p=>p.find(i=>i.id===product.id)?p.map(i=>i.id===product.id?{...i, quantity:i.quantity+1}:i):[...p,{...product, quantity:1}]);
    const removeFromCart = (productId) => setCart(p=>{const i=p.find(i=>i.id===productId);if(i.quantity===1)return p.filter(i=>i.id!==productId);return p.map(i=>i.id===productId?{...i,quantity:i.quantity-1}:i)});
    const cartTotal = cart.reduce((total, item) => total + item.price * item.quantity, 0);
    const [recipe, setRecipe] = useState('');
    const [isGeneratingRecipe, setIsGeneratingRecipe] = useState(false);

    const generateRecipe = async () => {
        if (cart.length === 0) return;
        
        setIsGeneratingRecipe(true);
        setRecipe('');

        const apiKey = ""; 
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-05-20:generateContent?key=${apiKey}`;

        const fruitNames = cart.map(item => item.name).join(', ');

        const systemPrompt = "Você é um chef de cozinha criativo e especialista em culinária brasileira, focado em receitas saudáveis e fáceis. Crie uma receita que seja deliciosa e simples de preparar.";
        const userQuery = `Crie uma receita refrescante e saborosa usando as seguintes frutas: ${fruitNames}. Forneça o nome da receita, os ingredientes (incluindo as frutas mencionadas e outros itens comuns de cozinha) e um passo a passo claro.`;

        const payload = {
            contents: [{ parts: [{ text: userQuery }] }],
            systemInstruction: {
                parts: [{ text: systemPrompt }]
            },
        };

        try {
            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (!response.ok) throw new Error(`API Error: ${response.statusText}`);
            
            const result = await response.json();
            const candidate = result.candidates?.[0];
            
            if (candidate && candidate.content?.parts?.[0]?.text) {
                setRecipe(candidate.content.parts[0].text);
            } else {
                setRecipe("Não foi possível gerar uma receita. Tente novamente.");
            }
        } catch (error) {
            console.error("Error generating recipe:", error);
            setRecipe("Ocorreu um erro ao gerar a receita. Por favor, verifique o console.");
        } finally {
            setIsGeneratingRecipe(false);
        }
    };


    return (
        <div className="p-4 md:p-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div className="lg:col-span-2">
                <h1 className="text-3xl font-bold text-gray-800 dark:text-gray-100 mb-6">Nossas Frutas Nativas</h1>
                <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                    {mockProducts.map((product) => (
                        <div key={product.id} className="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden transform hover:-translate-y-2 transition-transform duration-300 group">
                            <img src={product.image} alt={product.name} className="w-full h-48 object-cover" />
                            <div className="p-4">
                                <h3 className="text-xl font-bold text-gray-800 dark:text-gray-100">{product.name}</h3>
                                <p className="text-lg font-semibold text-green-600 dark:text-green-400 mt-1">R$ {product.price.toFixed(2).replace('.', ',')}</p>
                                <button onClick={() => addToCart(product)} className="w-full mt-4 bg-green-500 text-white font-bold py-2 px-4 rounded-lg hover:bg-green-600 transition-colors"> Adicionar ao Carrinho </button>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
            <div className="lg:col-span-1">
                <div className="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 sticky top-24 space-y-6">
                    <div>
                        <h2 className="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-4 flex items-center">
                            <ShoppingCartIcon itemCount={cart.reduce((a,c) => a + c.quantity, 0)} />
                            <span className="ml-2">Seu Carrinho</span>
                        </h2>
                        {cart.length === 0 ? (<p className="text-gray-500 dark:text-gray-400">Seu carrinho está vazio.</p>) : (
                            <>
                                <div className="space-y-4 max-h-60 overflow-y-auto pr-2">
                                    {cart.map(item => (
                                        <div key={item.id} className="flex justify-between items-center text-gray-800 dark:text-gray-200">
                                            <div><p className="font-bold">{item.name}</p><p className="text-sm text-gray-600 dark:text-gray-400">R$ {item.price.toFixed(2).replace('.', ',')}</p></div>
                                            <div className="flex items-center gap-2"><button onClick={() => removeFromCart(item.id)} className="w-6 h-6 rounded-full bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600">-</button><span>{item.quantity}</span><button onClick={() => addToCart(item)} className="w-6 h-6 rounded-full bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600">+</button></div>
                                        </div>
                                    ))}
                                </div>
                                <div className="border-t border-gray-200 dark:border-gray-700 mt-6 pt-4"><div className="flex justify-between font-bold text-lg text-gray-800 dark:text-gray-100"><span>Total</span><span>R$ {cartTotal.toFixed(2).replace('.', ',')}</span></div><button className="w-full mt-4 bg-green-600 text-white font-bold py-3 rounded-lg hover:bg-green-700 transition-colors">Finalizar Compra</button></div>
                            </>
                        )}
                    </div>

                    {cart.length > 0 && (
                        <div className="border-t border-gray-200 dark:border-gray-700 pt-6">
                            <button 
                                onClick={generateRecipe} 
                                disabled={isGeneratingRecipe}
                                className="w-full flex justify-center items-center gap-2 bg-teal-500 hover:bg-teal-600 text-white font-bold py-3 px-4 rounded-lg transition-colors disabled:bg-teal-300 disabled:cursor-not-allowed"
                            >
                                <SparklesIcon />
                                {isGeneratingRecipe ? 'Criando receita...' : 'Sugerir Receita com IA ✨'}
                            </button>
                            {isGeneratingRecipe && (
                                <div className="mt-4 text-center text-gray-600 dark:text-gray-300">
                                    <p>Aguarde, estamos buscando uma receita deliciosa para você...</p>
                                </div>
                            )}
                            {recipe && (
                                <div className="mt-4 bg-teal-50 dark:bg-teal-900/20 p-4 rounded-lg border border-teal-200 dark:border-teal-800">
                                    <h3 className="text-lg font-bold text-teal-800 dark:text-teal-300 mb-2">Sugestão do Chef:</h3>
                                    <div className="prose prose-sm dark:prose-invert text-gray-700 dark:text-gray-300 whitespace-pre-wrap">{recipe}</div>
                                </div>
                            )}
                        </div>
                    )}
                </div>
            </div>
        </div>
    );
};

